  "<div style=\"line-height:118%\">%1<br>Версия: %2<br>Тип: %3<br>Возможности: %4<br>Движок: %5<br>Ссылка: %6<br>Описание: %7<br>Папка: %8</div>": "<div style=\"line-height:118%\">%1<br>Version: %2<br>Type: %3<br>Capabilities: %4<br>Engine: %5<br>Link: %6<br>Description: %7<br>Folder: %8</div>",
