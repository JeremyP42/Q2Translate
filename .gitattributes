# Normalize line endings and keep binary assets untouched.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.filters text eol=crlf

*.ico binary
*.png binary
*.gif binary
*.webp binary
*.jpg binary
*.jpeg binary
*.onnx binary
*.dll binary
*.exe binary
*.lib binary
*.a binary
*.dll.a binary
*.traineddata binary
*.dic binary
*.zip binary
