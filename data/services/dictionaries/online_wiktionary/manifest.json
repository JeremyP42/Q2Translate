        },
        {
          "label": "Russian",
          "value": "ru"
        },
        {
          "label": "German",
          "value": "de"
        },
        {
          "label": "French",
          "value": "fr"
        },
        {
          "label": "Spanish",
          "value": "es"
        }
      ],
      "default": "en"
    }
  ],
  "link": "https://<language>.wiktionary.org/api/rest_v1/page/definition/",
  "enabled_by_default": false
