{
  "id": "online_wiktionary",
  "name": "Wiktionary",
  "version": "1.0.0",
  "type": "dictionaries",
  "engine": "javascript",
  "order": 10,
  "icon": "icon.png",
  "description": "Онлайн-словарь Wiktionary.",
  "capabilities": [
    "dictionary"
  ],
  "settings_schema": [
    {
      "key": "language",
